<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cpu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_cpu_bg_cyber"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_cpu_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="● LIVE CPU // TELEMETRY"
            android:textColor="#FFB388FF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_cpu_load_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="end"
            android:text="OPTIMAL"
            android:textColor="#FF00E676"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Middle CPU Usage Readout + Instant Refresh Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_cpu_usage_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="42%"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_cpu_cores_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="8 CORES • 1850 MHz"
                android:textColor="#CCB8D4E8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_cpu_refresh_btn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/widget_3g_toggle_off"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minWidth="104dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="↻ REFRESH"
            android:textColor="#FF00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CPU Load Progress Bar -->
    <ProgressBar
        android:id="@+id/widget_cpu_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="42"
        android:progressDrawable="@drawable/widget_cpu_progress_bar" />

</LinearLayout>
